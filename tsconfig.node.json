{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": ".tsbuild/node",
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "*.config.ts",
    "packages/*/*.config.ts",
    "packages/*/test/**/*.ts",
    "apps/*/*.config.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "apps/docs/lib/registry.ts"
  ]
}
