{
  "name": "@kerb/tokens",
  "version": "1.0.0",
  "description": "Kerb design tokens as CSS variables and JSON for the light, dark and comfort themes",
  "license": "MIT",
  "author": "Dac Nhat Anh Bui",
  "homepage": "https://kerb-docs.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buidacnhatanh-dev/kerb-design-system.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/buidacnhatanh-dev/kerb-design-system/issues"
  },
  "keywords": [
    "design-tokens",
    "css-variables",
    "accessibility",
    "themes",
    "design-system"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.json"
    },
    "./kerb.css": "./dist/kerb.css",
    "./light.css": "./dist/light.css",
    "./dark.css": "./dist/dark.css",
    "./comfort.css": "./dist/comfort.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "style-dictionary": "^5.6.1"
  }
}
