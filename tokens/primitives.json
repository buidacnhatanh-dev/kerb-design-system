      "min": {
        "$type": "dimension",
        "$value": "2.75rem"
      },
      "compact": {
        "$type": "dimension",
        "$value": "2.5rem"
      },
      "default": {
        "$type": "dimension",
        "$value": "3rem"
      },
      "spacious": {
        "$type": "dimension",
        "$value": "3.5rem"
      }
    }
  },
  "focus": {
    "width": {
      "standard": {
        "$type": "dimension",
        "$value": "6px"
      },
      "thick": {
        "$type": "dimension",
        "$value": "8px"
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "120ms"
      },
      "base": {
        "$type": "duration",
        "$value": "200ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "320ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      }
    }
  }
