{
  "name": "@kerb/react",
  "version": "0.0.0",
  "description": "Accessibility first React components with light, dark and comfort themes",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./head-script": {
      "types": "./dist/head-script.d.ts",
      "import": "./dist/head-script.js"
    },
    "./kerb.css": "./dist/kerb.css",
    "./fonts.css": "./dist/fonts.css",
    "./global.css": "./dist/global.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@kerb/tokens": "workspace:*"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/overpass": "^5.3.0",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "vitest-axe": "^0.1.0"
  }
}
